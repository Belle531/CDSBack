# Database table names and Lambda function names for each app
CONTACTFORM_TABLE=ContactFormTable
CONTACTFORM_LAMBDA=ContactFormHandler
LOGINVIEW_TABLE=LoginViewTable
LOGINVIEW_LAMBDA=LoginViewHandler
RECIPEPAGE_TABLE=RecipePageTable
RECIPEPAGE_LAMBDA=RecipePageHandler
REGISTERVIEW_TABLE=RegisterViewTable
REGISTERVIEW_LAMBDA=RegisterViewHandler
SPICERACK_TABLE=SpiceRackTable
SPICERACK_LAMBDA=SpiceRackHandler
TODOAPP_TABLE=ToDoTaskManager
TODOAPP_LAMBDA=ToDoTaskManager
WEATHERAPP_TABLE=WeatherAppTable
WEATHERAPP_LAMBDA=WeatherAppHandler

# Legacy/other tables
USERS_TABLE=cds-spice-rack-api-users-dev
RECIPES_TABLE=cds-spice-rack-api-recipes-dev
FAVORITES_TABLE=cds-spice-rack-api-favorites-dev
RATINGS_TABLE=cds-spice-rack-api-ratings-dev
